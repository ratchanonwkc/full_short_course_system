# ==============================================================================
# Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Endpoint (Points to Express API v1 / standard routes)
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Project URL (Required by Supabase Client and resolveStorageUrl for dynamic image loading)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Safe for client-side usage; respects Row-Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
